---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";

const { sideBarActiveItemID } = Astro.props;

const PROFILE_IMAGE_URL = "https://ik.imagekit.io/stephanie/Personal%20Image/image.png";
---

<div class="drawer-side z-40">
    <label for="my-drawer" class="drawer-overlay"></label>

    <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">

        <!-- Profile -->
        <div class="w-full mt-5 mb-6 text-center">

            <a href="/" class="block">
                <div class="avatar transition ease-in-out hover:scale-[102%]">
                    <div class="w-[8.5rem]">
                        <img
                            class="mask mask-circle"
                            src={PROFILE_IMAGE_URL}
                            alt="stephfee profile image"
                        />
                    </div>
                </div>
            </a>

            <div class="mt-4 px-3">
                <h1 class="text-xl font-bold">
                    stephfee
                </h1>

                <p class="text-xs opacity-70 mt-1">
                    IT Support & Technology
                </p>

            </div>

        </div>

        <!-- Navigation -->
        <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />

        <!-- Footer / Social Links -->
        <SideBarFooter />

    </aside>
</div>