---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">IT support projects</div>
  </div>

  <HorizontalCard
    title="Lumen Systems IT Support Portfolio"
    desc="This repository simulates the day-to-day IT Support operations of a mid-sized Toronto-based company. It is designed to demonstrate practical, job-ready IT support skills including ticket triage, troubleshooting methodology, technical documentation, and knowledge base management using realistic scenarios based on common issues faced by IT Support teams in Canadian workplaces."
    url="https://github.com/hurabono/Lumen-Systems-IT-Support-Portfolio"
    badge="IT SUPPORT"
  />
  <div class="divider my-0"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Coding projects</div>
  </div>

  <HorizontalCard
    title="Emobudget"
    img="https://ik.imagekit.io/stephanie/git-thum/emobudget.png"
    desc="A personal expense tracking app built with React Native and Spring Boot, featuring machine learning-based emotional spending analysis and a user-friendly interface.."
    url="https://github.com/hurabono/emobudget2.0"
    badge="Fullstack"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Retail Fun Time"
    img="https://ik.imagekit.io/stephanie/git-thum/retailruntime.png"
    desc="A full-stack mobile app for retail employee management, providing real-time clock-in/out, scheduling, leave requests, and payroll tracking for both employees and managers."
    url="https://github.com/hurabono/retail_funtime2.0"
    badge="Group project"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Check Security App"
    img="https://ik.imagekit.io/stephanie/git-thum/security.png"
    desc="A mobile cybersecurity awareness and diagnostic app that helps users easily check device security, detect potential risks, and learn safer digital habits."
    url="https://github.com/hurabono/check-check-security-app"
  />
</BaseLayout>
