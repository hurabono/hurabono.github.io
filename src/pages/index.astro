---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);

const labPosts = (await getCollection("lab"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there</div>
    <div class="text-5xl font-bold">I'm stephfee👋</div>
    <div class="text-3xl py-3 font-bold">IT Support & Technician</div>
    <div class="py-2">
      <text class="text-lg">
        I like figuring out why things break and learning how to fix them
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/stephfee" target="_blank"> Let's connect!</a>
      <a href="https://github.com/hurabono" target="_blank" class="btn btn-outline ml-5">
        Github
      </a>
    </div>
  </div>

  <section class="mt-8 mb-8">
      <div class="flex items-center justify-between mb-6">
          <div class="text-3xl w-full font-bold mb-2">
            Latest from Lab
          </div>

          <a href="/lab" class="w-full link link-hover text-end">
              View all →
          </a>
      </div>

      {
          labPosts.map((post) => (
              <HorizontalCard
                  title={post.data.title}
                  img={post.data.heroImage}
                  desc={post.data.description}
                  url={"/lab/" + createSlug(post.data.title, post.slug)}
                  target="_self"
                  badge={post.data.badge}
                  tags={post.data.tags}
              />
          ))
      }
  </section>

  <div class="divider my-0"></div>

  <section class="mt-8 mb-8">
      <div class="flex items-center justify-between mb-6">
          <div class="w-full text-3xl font-bold">
              Latest from Blog
          </div>

          <a
              href="/blog"
              class="w-full link link-hover text-end"
          >
              View all →
          </a>
      </div>

      {
          last_posts.map((post) => (
              <HorizontalCard
                  title={post.data.title}
                  img={post.data.heroImage}
                  desc={post.data.description}
                  url={"/blog/" + createSlug(post.data.title, post.slug)}
                  target="_self"
                  badge={post.data.badge}
                  tags={post.data.tags}
              />
          ))
      }
  </section>

<div class="divider my-0"></div>

  <section class="mt-10 mb-8">
      <div class="mt-8 mb-8">
        <div class="text-3xl w-full font-bold">My last projects {"</>"}</div>
      </div>

        <HorizontalCard
          title="Lumen Systems IT Support Portfolio"
          desc="This repository simulates the day-to-day IT Support operations of a mid-sized Toronto-based company. It is designed to demonstrate practical, job-ready IT support skills including ticket triage, troubleshooting methodology, technical documentation, and knowledge base management using realistic scenarios based on common issues faced by IT Support teams in Canadian workplaces."
          url="https://github.com/hurabono/Lumen-Systems-IT-Support-Portfolio"
          badge="IT SUPPORT"
        />

        <HorizontalCard
          title="Emobudget"
          img="https://ik.imagekit.io/stephanie/git-thum/emobudget.png"
          desc="A personal expense tracking app built with React Native and Spring Boot, featuring machine learning-based emotional spending analysis and a user-friendly interface.."
          url="https://github.com/hurabono/emobudget2.0"
          badge="Fullstack"
        />

        <HorizontalCard
          title="Retail Fun Time"
          img="https://ik.imagekit.io/stephanie/git-thum/retailruntime.png"
          desc="A full-stack mobile app for retail employee management, providing real-time clock-in/out, scheduling, leave requests, and payroll tracking for both employees and managers."
          url="https://github.com/hurabono/retail_funtime2.0"
          badge="Group project"
        />
  </section>

</BaseLayout>
